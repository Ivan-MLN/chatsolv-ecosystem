APP_ENV=development
APP_PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatsolv?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PASSWORD_RESET_TTL=15m
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cs.naeladtya.my.id
REQUEST_BODY_LIMIT=16384
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1m
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=debug
VAULT_ROOT=/data/chatsolv/vaults
HERMES_BINARY=hermes
HERMES_ROOT=/data/chatsolv/hermes
HERMES_TEMPLATE_PROFILE=default
JOB_POLL_INTERVAL=2s
JOB_MAX_ATTEMPTS=5
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=chatsolv-originals
OBJECT_STORAGE_ACCESS_KEY=chatsolv
OBJECT_STORAGE_SECRET_KEY=chatsolv-development-secret
OBJECT_STORAGE_USE_SSL=false
# WhatsApp Bot Service integration contract: docs/WHATSAPP_INTEGRATION.md
WHATSAPP_SERVICE_URL=http://localhost:4010
INTERNAL_SERVICE_SECRET=replace-with-at-least-32-random-bytes
WEBHOOK_ENCRYPTION_KEY=change-me-32-byte-encryption-key
