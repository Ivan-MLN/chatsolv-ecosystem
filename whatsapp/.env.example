# ChatSolv WhatsApp Bot Service
# Copy to .env and fill in the values.

# Service port (must match WHATSAPP_SERVICE_URL in backend .env)
PORT=4010

# Shared HMAC secret with ChatSolv backend (must be identical to INTERNAL_SERVICE_SECRET in backend)
INTERNAL_SERVICE_SECRET=replace-with-at-least-32-random-bytes

# ChatSolv backend base URL (this service calls backend callbacks)
BACKEND_URL=http://localhost:3000

# Directory to store per-channel SQLite databases
DB_ROOT=./data/sessions

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Timeout for HTTP callbacks to backend
CALLBACK_TIMEOUT=10s

# Graceful shutdown timeout
SHUTDOWN_TIMEOUT=10s

# App environment (development | production)
APP_ENV=development
